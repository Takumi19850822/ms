generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ResourceRecord {
  id         String   @id @default(cuid())
  resourceId String
  code       String
  name       String
  storeId    String?
  note       String   @default("")
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([resourceId, storeId])
}

model AppUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  storeId      String?
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([storeId])
}
